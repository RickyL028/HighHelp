{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "highhelp",
	"main": "src/index.tsx",
	"compatibility_date": "2026-07-18",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "highhelp.org",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"preview_urls": true,
	"queues": {
		"producers": [
			{
				"binding": "AI_QUEUE",
				"queue": "paper-ai-queue"
			}
		],
		"consumers": [
			{
				"queue": "paper-ai-queue",
				"max_batch_size": 1,
				"max_batch_timeout": 0, 
				"max_retries": 1,
				"dead_letter_queue": "paper-ai-dlq"
			}
		]
	},
	"limits": {
		"cpu_ms": 300000
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "highhelp-db",
			"database_id": "263d5506-f24e-48fd-a7c8-b05cb6c3e55f"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "highhelp-storage",
			"preview_bucket_name": "my-app-preview-bucket"
		}
	],
	"assets": {
		"directory": "./public"
	},
	"vars": {
		"PORTAL_API_CLIENT_ID": "01kdpqeyf5eeb8nbpvwj1bp22w",
		"PORTAL_API_CLIENT_ID_full": "01khd5yr82f56trpdz32s0zm8p",
		"APP_REDIRECT_URI": "https://highhelp.sbhs27.workers.dev/api/auth/callback",
		"APP_REDIRECT_URI_full": "https://highhelp.org/api/auth/callback"
	}
}